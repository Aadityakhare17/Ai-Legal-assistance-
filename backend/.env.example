# NyayaSetu Backend Environment Configuration
# Copy this file to .env and fill in your values

# Application
APP_NAME="NyayaSetu"
APP_VERSION="1.0.0"
DEBUG=true
SECRET_KEY="your-super-secret-key-change-in-production-min-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (SQLite for dev, PostgreSQL for prod)
DATABASE_URL="sqlite+aiosqlite:///./nyayasetu.db"
# DATABASE_URL="postgresql+asyncpg://user:password@localhost:5432/nyayasetu"

# LLM Provider Selection ("auto", "grok", or "gemini")
LLM_PROVIDER="auto"

# Grok (xAI) API
GROK_API_KEY="your-xai-grok-api-key-here"
GROK_MODEL="grok-2-latest"
GROK_BASE_URL="https://api.x.ai/v1"

# Google Gemini AI
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-1.5-flash"
EMBEDDING_MODEL="models/text-embedding-004"

# Demo Mode (set to true to use pre-computed demo data without API calls)
DEMO_MODE=true

# File Upload
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=20
ALLOWED_EXTENSIONS=".pdf,.docx,.txt,.doc"

# ChromaDB Vector Store
CHROMA_PERSIST_DIR="./chroma_db"
CHROMA_COLLECTION="nyayasetu_docs"

# CORS
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# Rate Limiting
RATE_LIMIT_PER_MINUTE=30
